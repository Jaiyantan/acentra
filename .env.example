# =====================================================================
# SAVEETHA MEDICAL COLLEGE & HOSPITAL (SMCH) - ACENTRA OPERATIONS
# Cognee Dynamic Operational Ontology & Intelligence Platform Config
# =====================================================================

# 1. Cognee Local Embedded Storage (Kùzu Graph + LanceDB Vectors)
VECTOR_DB_PROVIDER=lancedb
GRAPH_DATABASE_PROVIDER=kuzu
ENABLE_BACKEND_ACCESS_CONTROL=false
CACHING=true

# 2. LLM Configuration for Knowledge Graph Extraction & Governed Agent
# Supported: groq, ollama, bedrock, openai
LLM_PROVIDER=groq
LLM_MODEL=groq/qwen/qwen3.8-27b
LLM_ENDPOINT=
LLM_API_KEY=your_groq_or_openai_api_key_here

# 3. Embedding Configuration (fastembed — local, CPU, offline, no API key needed)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# 4. Optional Cloud Provider Credentials (e.g. AWS Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
